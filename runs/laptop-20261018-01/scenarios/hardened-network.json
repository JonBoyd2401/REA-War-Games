{
  "browser": {
    "mode": "launch",
    "executable_path": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
    "headless": true
  },
  "start_url": {
    "url": "http://127.0.0.1:3001"
  },
  "actions": [
    {
      "step_id": "quote-click",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "#quote"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "quote-rendered",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "#result:not(:empty)"
      },
      "state": "visible",
      "timeout_ms": 10000
    }
  ],
  "capture": {
    "at_end": [
      "dom",
      "accessibility",
      "url"
    ],
    "events": [
      "network"
    ],
    "network": {
      "request_body": true,
      "response_body": true,
      "header_values": false
    }
  }
}
