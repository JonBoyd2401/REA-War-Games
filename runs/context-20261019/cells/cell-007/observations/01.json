  "pageHtml": "<!DOCTYPE html><html><head><title>Exact quote workspace</title></head><body><h1>Exact quote workspace</h1><p>Two business contexts: own and other. All amounts are exact GBP pence. Integer quantities 1..1000. Create, revise, accept, export and background export are available. The signed-in customer owns context own. A known other-context object is other-seed and job other-job.</p><label>Workflow JSON<textarea id=\"request\">{\"op\":\"create\",\"context\":\"own\",\"quantity\":50}</textarea></label><button id=\"calculate\">Run workflow</button><div id=\"history\"></div><script src=\"/app.js\"></script></body></html>",
  "deliveredScripts": [
    "document.querySelector('#calculate').addEventListener('click',async()=>{\n const request=JSON.parse(document.querySelector('#request').value);\n const r=await fetch('/api/workflow',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(request)});\n const history=document.querySelector('#history'),row=document.createElement('pre');row.dataset.index=String(history.children.length);row.textContent=JSON.stringify({request,status:r.status,body:await r.json()});history.appendChild(row);\n});"
