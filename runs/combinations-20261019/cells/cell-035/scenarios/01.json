{
  "browser": {
    "mode": "launch",
    "executable_path": "C:/Program Files/Google/Chrome/Application/chrome.exe",
    "headless": true
  },
  "start_url": {
    "url": "http://127.0.0.1:49861"
  },
  "actions": [
    {
      "step_id": "inspect",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "#calculate"
      },
      "state": "visible",
      "timeout_ms": 10000
    }
  ],
  "secrets": [
    {
      "secret_id": "agentSession",
      "environment_variable": "REA_AGENT_SESSION"
    }
  ],
  "storage": {
    "cookies": [
      {
        "name": "agent_session",
        "value": {
          "source": "secret",
          "secret_id": "agentSession"
        },
        "destination": {
          "url": "http://127.0.0.1:49861"
        },
        "http_only": true,
        "secure": false,
        "same_site": "Strict"
      }
    ]
  },
  "capture": {
    "at_end": [
      "dom"
    ],
    "events": [
      "network"
    ],
    "network": {
      "request_body": true,
      "response_body": true,
      "header_values": false
    }
  }
}