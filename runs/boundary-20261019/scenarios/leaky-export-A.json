{
  "browser": {
    "mode": "launch",
    "executable_path": "C:/Program Files/Google/Chrome/Application/chrome.exe",
    "headless": true
  },
  "start_url": {
    "url": "http://127.0.0.1:53230"
  },
  "actions": [
    {
      "step_id": "run",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "#run"
      },
      "timeout_ms": 10000
    },
    {
      "step_id": "done",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "#result:not(:empty)"
      },
      "state": "visible",
      "timeout_ms": 20000
    }
  ],
  "secrets": [
    {
      "secret_id": "boundarySession",
      "environment_variable": "REA_BOUNDARY_SESSION"
    }
  ],
  "storage": {
    "cookies": [
      {
        "name": "boundary_session",
        "value": {
          "source": "secret",
          "secret_id": "boundarySession"
        },
        "destination": {
          "url": "http://127.0.0.1:53230"
        },
        "http_only": true,
        "secure": false,
        "same_site": "Strict"
      }
    ]
  },
  "capture": {
    "at_end": [
      "dom",
      "accessibility",
      "url"
    ],
    "events": [
      "network"
    ],
    "network": {
      "request_body": true,
      "response_body": true,
      "header_values": false
    }
  }
}
