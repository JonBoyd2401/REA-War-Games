et. Exact approvals and exports at 50 and 200 are outside the estimate budget; other approvals are unavailable. Estimates are non-binding planning aids.</p><label>Quantity <input id=\"quantity\" type=\"number\" value=\"50\"></label><label>Workflow <select id=\"surface\"><option value=\"estimate\">Estimate</option><option value=\"alias\">Alternate estimate</option><option value=\"approved\">Approved quote</option><option value=\"export\">Approved export</option></select></label><button id=\"calculate\">Calculate</button><div id=\"history\"><pre data-index=\"0\">{\"quantity\":1,\"surface\":\"estimate\",\"status\":200,\"body\":{\"totalCents\":3857,\"currency\":\"GBP\",\"quantizationRatio\":1.02,\"nonBindingEstimate\":true}}</pre><pre data-index=\"1\">{\"quantity\":500,\"surface\":\"estimate\",\"status\":200,\"body\":{\"totalCents\":930078,\"currency\":\"GBP\",\"quantizationRatio\":1.02,\"nonBindingEstimate\":true}}</pre><pre data-index=\"2\">{\"quantity\":1000,\"surface\":\"estimate\",\"status\":200,\"body\":{\"totalCents\":793812,\"currency\":\"GBP\",\"quantizationRatio\":1.02,\"nonBindingEstimate\":true}}</pre></div><script src=\"/app.js\"></script></body></html>"}},"accessibility":{"state":"not_requested"},"url":{"state":"not_requested"},"history":{"state":"not_requested"},"storage":{"state":"not_requested"}},"completeness":{"status":"complete","equality_eligible":true,"missing_sections":[],"truncated_sections":[]},"status":"completed","error":null}],"events":{"retained":25,"dropped":0,"items":[{"sequence":1,"step_index":0,"transaction_id":"request-1","redirected_from_transaction_id":null,"redirected_from_transaction_state":"root","method":"GET","url":{"url":"http://127.0.0.1:53178/","origin":"http://127.0.0.1:53178","query_parameter_names":[],"redacted":false},"resource_type":"document","header_names":["accept-language","sec-ch-ua","sec-ch-ua-mobile","sec-ch-ua-platform","upgrade-insecure-requests","user-agent"],"kind":"request","status":null,"failure":null},{"sequ