{
  "browser": {
    "mode": "launch",
    "executable_path": "C:/Program Files/Google/Chrome/Application/chrome.exe",
    "headless": true
  },
  "start_url": {
    "url": "http://127.0.0.1:50724"
  },
  "actions": [
    {
      "step_id": "quantity-0",
      "action": "fill",
      "locator": {
        "kind": "css",
        "selector": "#quantity"
      },
      "value": {
        "source": "literal",
        "value": "125"
      }
    },
    {
      "step_id": "surface-0",
      "action": "select_option",
      "locator": {
        "kind": "css",
        "selector": "#surface"
      },
      "value": {
        "source": "literal",
        "value": "estimate"
      }
    },
    {
      "step_id": "submit-0",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "#calculate"
      }
    },
    {
      "step_id": "result-0",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "#history pre[data-index=\"0\"]"
      },
      "state": "visible",
      "timeout_ms": 10000
    },
    {
      "step_id": "quantity-1",
      "action": "fill",
      "locator": {
        "kind": "css",
        "selector": "#quantity"
      },
      "value": {
        "source": "literal",
        "value": "500"
      }
    },
    {
      "step_id": "surface-1",
      "action": "select_option",
      "locator": {
        "kind": "css",
        "selector": "#surface"
      },
      "value": {
        "source": "literal",
        "value": "estimate"
      }
    },
    {
      "step_id": "submit-1",
      "action": "click",
      "locator": {
        "kind": "css",
        "selector": "#calculate"
      }
    },
    {
      "step_id": "result-1",
      "action": "wait_for",
      "locator": {
        "kind": "css",
        "selector": "#history pre[data-index=\"1\"]"
      },
      "state": "visible",
      "timeout_ms": 10000
    }
  ],
  "secrets": [
    {
      "secret_id": "agentSession",
      "environment_variable": "REA_AGENT_SESSION"
    }
  ],
  "storage": {
    "cookies": [
      {
        "name": "agent_session",
        "value": {
          "source": "secret",
          "secret_id": "agentSession"
        },
        "destination": {
          "url": "http://127.0.0.1:50724"
        },
        "http_only": true,
        "secure": false,
        "same_site": "Strict"
      }
    ]
  },
  "capture": {
    "at_end": [
      "dom"
    ],
    "events": [
      "network"
    ],
    "network": {
      "request_body": true,
      "response_body": true,
      "header_values": false
    }
  }
}